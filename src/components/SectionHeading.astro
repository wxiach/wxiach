---
interface Props {
  title: string;
  sub: string;
}
const { title, sub } = Astro.props;
---

<div class="flex w-32 shrink-0 flex-col gap-2">
  <h2 class="text-xl font-bold text-heading">{title}</h2>
  <span class="text-[0.7rem] uppercase tracking-[0.22em] text-subtle">
    {sub}
  </span>
</div>
