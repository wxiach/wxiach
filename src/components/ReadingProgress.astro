<div
  id="reading-progress"
  class="fixed top-0 left-0 z-[60] h-0.5 w-full origin-left scale-x-0 bg-accent"
  aria-hidden="true"
></div>

<button
  id="back-to-top"
  type="button"
  aria-label="回到顶部"
  title="回到顶部"
  disabled
  class="pointer-events-none fixed z-50 flex h-11 w-11 translate-y-2 cursor-pointer flex-col items-center justify-center gap-0.5 rounded-full border border-line-strong bg-page/90 text-muted opacity-0 backdrop-blur transition-[opacity,transform] duration-200 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent data-[visible=true]:pointer-events-auto data-[visible=true]:translate-y-0 data-[visible=true]:opacity-100"
>
  <svg
    class="h-3 w-3"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M12 19V5M5 12l7-7 7 7" />
  </svg>
  <span
    id="scroll-percentage"
    class="text-[0.6875rem] leading-none tabular-nums"
    aria-hidden="true"
  >
    0%
  </span>
</button>

<style>
  #back-to-top {
    right: max(1.5rem, calc(50% - 27.5rem));
    bottom: max(1.5rem, env(safe-area-inset-bottom));
  }
</style>

<script>
  function setupReadingProgress() {
    const button = document.querySelector<HTMLButtonElement>('#back-to-top');
    const percentage = document.getElementById('scroll-percentage');
    const progressBar = document.getElementById('reading-progress');

    if (!button || !percentage || !progressBar) return;

    const updateProgress = () => {
      const scrollableHeight =
        document.documentElement.scrollHeight - window.innerHeight;
      let progress = 0;

      if (scrollableHeight > 0) {
        progress = Math.max(0, Math.min(1, window.scrollY / scrollableHeight));
      }

      const percent = Math.round(progress * 100);
      const showButton =
        scrollableHeight > 0 &&
        window.scrollY >= Math.min(400, scrollableHeight);

      percentage.textContent = `${percent}%`;
      progressBar.style.transform = `scaleX(${progress})`;
      button.dataset.visible = String(showButton);
      button.disabled = !showButton;
      button.setAttribute('aria-label', `回到顶部，已滚动 ${percent}%`);
    };

    updateProgress();
    window.addEventListener('scroll', updateProgress, { passive: true });
    window.addEventListener('resize', updateProgress);
    window.addEventListener('pageshow', updateProgress);
    new ResizeObserver(updateProgress).observe(document.body);

    button.addEventListener('click', () => {
      const reducedMotion = window.matchMedia(
        '(prefers-reduced-motion: reduce)',
      ).matches;
      window.scrollTo({
        top: 0,
        behavior: reducedMotion ? 'instant' : 'smooth',
      });
    });
  }

  setupReadingProgress();
</script>
