---
interface Props {
  title: string;
  description: string;
  href: string;
  label?: string;
}

const { title, description, href, label } = Astro.props;
const url = new URL(href);
const linkLabel = label ?? `${url.host}${url.pathname.replace(/\/$/, '')}`;
const source = url.hostname === 'github.com' ? 'GitHub' : url.hostname;
---

<a
  class="project-card not-prose"
  href={href}
  target="_blank"
  rel="noopener noreferrer"
>
  <span class="project-card__header">
    <span class="project-card__title">{title}</span>
    <svg
      class="project-card__arrow"
      aria-hidden="true"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M7 17 17 7M7 7h10v10" />
    </svg>
  </span>
  <span class="project-card__description">{description}</span>
  <span class="project-card__footer">
    <span class="project-card__source">{source}</span>
    <span class="project-card__link">{linkLabel}</span>
  </span>
</a>

<style>
  .project-card {
    --card-border: color-mix(in oklab, var(--color-stone-400) 28%, transparent);
    --card-background: rgb(255 255 255 / 40%);
    --card-title: var(--color-stone-800);
    --card-description: var(--color-stone-600);
    --card-muted: var(--color-stone-500);
    display: flex;
    min-width: 0;
    flex-direction: column;
    padding: 0.875rem 1rem;
    border: 1px solid var(--card-border);
    border-radius: 0.5rem;
    background-color: var(--card-background);
    text-decoration: none;
    line-height: 1.5;
    transition:
      border-color 0.2s ease,
      background-color 0.2s ease;
  }
  .project-card__header {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    min-width: 0;
  }
  .project-card__title {
    min-width: 0;
    color: var(--card-title);
    font-size: 1rem;
    font-weight: 600;
    overflow-wrap: anywhere;
    transition: color 0.2s ease;
  }
  .project-card__arrow {
    width: 0.875rem;
    height: 0.875rem;
    flex-shrink: 0;
    margin-left: auto;
    color: var(--card-muted);
    transition: color 0.2s ease;
  }
  .project-card__description {
    flex-grow: 1;
    margin-top: 0.375rem;
    color: var(--card-description);
    font-size: 0.8125rem;
    line-height: 1.65;
  }
  .project-card__footer {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.25rem 0.625rem;
    margin-top: 0.625rem;
    color: var(--card-muted);
    font-size: 0.6875rem;
    line-height: 1.6;
  }
  .project-card__source {
    flex-shrink: 0;
  }
  .project-card__link {
    min-width: 0;
    font-family: var(--font-mono);
    overflow-wrap: anywhere;
  }
  .project-card:is(:hover, :focus-visible) {
    border-color: color-mix(in oklab, var(--color-accent) 55%, transparent);
    background-color: color-mix(
      in oklab,
      var(--color-accent) 3%,
      var(--card-background)
    );
    text-decoration: none;
  }
  .project-card:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }
  .project-card:is(:hover, :focus-visible) .project-card__title {
    color: var(--color-accent);
  }
  .project-card:is(:hover, :focus-visible) .project-card__arrow {
    color: var(--color-accent);
  }
  :global(html.dark) .project-card {
    --card-border: color-mix(in oklab, var(--color-stone-500) 30%, transparent);
    --card-background: rgb(255 255 255 / 3%);
    --card-title: var(--color-stone-200);
    --card-description: var(--color-stone-400);
    --card-muted: var(--color-stone-400);
  }
</style>
