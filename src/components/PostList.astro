---
import { postPath } from '../lib/paths';
import { formatPostDate } from '../lib/posts';
import type { Post } from '../lib/posts';

interface Props {
  posts: Post[];
  baseStage: number;
}

const { posts, baseStage } = Astro.props;
---

<div class="min-w-0 flex-1">
  {posts.map((post, index) => (
    <article
      class="enter border-b border-line py-5 first:pt-0"
      style={`--enter-stage: ${baseStage + index}`}
    >
      <p class="mb-1.5 text-meta tabular-nums text-subtle">
        {formatPostDate(post.data.date)}
      </p>
      <div class="flex items-baseline justify-between gap-3">
        <h3 class="text-[1.0625rem] leading-7 font-semibold text-ink">
          <a
            href={postPath(post.id)}
            class="inline-block focus-visible:outline-none"
          >
            {post.data.title}
          </a>
        </h3>
        {post.data.tags[0] && (
          <span class="shrink-0 text-meta text-muted">
            #{post.data.tags[0]}
          </span>
        )}
      </div>
      {post.data.description && (
        <p class="mt-1.5 text-base leading-6 text-muted">
          {post.data.description}
        </p>
      )}
    </article>
  ))}
</div>
