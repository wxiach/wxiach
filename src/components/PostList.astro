---
import type { CollectionEntry } from 'astro:content';

interface Props {
  posts: CollectionEntry<'posts'>[];
  baseStage?: number;
  showDescription?: boolean;
}
const { posts, baseStage = 0, showDescription = true } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

function formatDate(date: Date) {
  return date.toLocaleDateString('zh-CN', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    timeZone: 'UTC',
  });
}
---

<div class="min-w-0 flex-1">
  {posts.map((post, i) => (
    <article
      class="group enter border-b border-stone-200 py-5 first:pt-0 dark:border-stone-800"
      style={`--enter-stage: ${baseStage + i}`}
      data-tags={post.data.tags.join('|')}
    >
      <p class="mb-2 text-[0.82rem] tracking-wide text-stone-400 dark:text-stone-500">
        {formatDate(post.data.date)}
      </p>
      <div class="flex items-baseline justify-between gap-5">
        <h3 class="text-[1.05rem] leading-7 font-medium text-stone-900 dark:text-stone-100">
          <a
            href={`${base}blog/${post.id}/`}
            class="inline-block underline decoration-transparent decoration-[1.5px] underline-offset-5 transition-all duration-200 group-hover:text-accent group-hover:decoration-accent active:text-accent"
          >
            {post.data.title}
          </a>
        </h3>
        {post.data.tags[0] && (
          <a
            href={`${base}blog/?tag=${encodeURIComponent(post.data.tags[0])}`}
            class="shrink-0 text-sm text-stone-500 transition-colors hover:text-accent dark:text-stone-400 dark:hover:text-accent"
          >
            #{post.data.tags[0]}
          </a>
        )}
      </div>
      {showDescription && post.data.description && (
        <p class="mt-2 text-[0.95rem] leading-7 text-stone-500 transition-colors duration-200 group-hover:text-stone-600 dark:text-stone-400 dark:group-hover:text-stone-300">
          {post.data.description}
        </p>
      )}
    </article>
  ))}
  <slot />
</div>
