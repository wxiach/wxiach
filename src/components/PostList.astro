---
import type { CollectionEntry } from 'astro:content';

interface Props {
  posts: CollectionEntry<'posts'>[];
  baseStage?: number;
}
const { posts, baseStage = 0 } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

function formatDate(date: Date) {
  return date.toLocaleDateString('zh-CN', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    timeZone: 'UTC',
  });
}
---

<div class="min-w-0 flex-1">
  {posts.map((post, i) => (
    <article
      class="enter border-b border-stone-200 py-4 first:pt-0 dark:border-stone-800"
      style={`--enter-stage: ${baseStage + i}`}
      data-tags={post.data.tags.join('|')}
    >
      <p class="mb-1.5 text-sm text-stone-500 dark:text-stone-400">
        {formatDate(post.data.date)}
      </p>
      <div class="flex items-baseline justify-between gap-4">
        <h3 class="text-base text-stone-900 dark:text-stone-100">
          <a
            href={`${base}blog/${post.id}/`}
            class="inline-block transition-all duration-300 hover:translate-x-2 hover:text-accent active:text-accent"
          >
            {post.data.title}
          </a>
        </h3>
        {post.data.tags[0] && (
          <a
            href={`${base}blog/?tag=${encodeURIComponent(post.data.tags[0])}`}
            class="shrink-0 text-sm text-stone-500 transition-colors hover:text-stone-900 dark:text-stone-400 dark:hover:text-stone-100"
          >
            #{post.data.tags[0]}
          </a>
        )}
      </div>
    </article>
  ))}
  <slot />
</div>
