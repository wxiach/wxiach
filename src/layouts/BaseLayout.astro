---
import '../styles/global.css';
import 'lxgw-wenkai-screen-webfont/lxgwwenkaiscreen.css';
import ReadingProgress from '../components/ReadingProgress.astro';
import { basePath } from '../lib/paths';
import { site } from '../site.config';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  noindex?: boolean;
}
const {
  title = site.name,
  description = site.description,
  type = 'website',
  publishedTime,
  noindex = false,
} = Astro.props;
const isHome = Astro.url.pathname === basePath;
const rssPath = `${basePath}rss.xml`;
const SiteName = isHome ? 'h1' : 'span';
const year = new Date().getFullYear();
const ogImage = new URL(`${basePath}${site.images.avatar}`, site.url).href;
const canonicalUrl = new URL(Astro.url.pathname, site.url).href;
const articlePublishedTime = publishedTime?.toISOString();
const navLinkClass =
  'inline-block min-h-11 min-w-11 px-2.5 py-3 text-center focus-visible:outline-none';
---

<!doctype html>
<html lang={site.language}>
  <head>
    <meta charset="UTF-8" />
    <link
      rel="icon"
      type="image/png"
      sizes="48x48"
      href={`${basePath}${site.images.favicon}`}
    />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href={`${basePath}${site.images.touchIcon}`}
    />
    <link rel="canonical" href={canonicalUrl} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${site.name} RSS`}
      href={rssPath}
    />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={site.language.replace('-', '_')} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={`${site.name}的头像`} />
    {articlePublishedTime && (
      <meta property="article:published_time" content={articlePublishedTime} />
    )}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <title>{title}</title>
  </head>
  <body class="flex min-h-svh flex-col">
    <header class="sticky top-0 z-50 border-b border-line bg-page/85 backdrop-blur-xl backdrop-saturate-150">
      <div class="mx-auto flex h-16 max-w-site items-center justify-between gap-3 px-5 sm:max-w-[calc(var(--container-site)+1.5rem)] sm:gap-4">
        <a
          href={basePath}
          aria-label={`${site.name}，返回首页`}
          aria-current={isHome ? 'page' : undefined}
          class="flex min-h-11 min-w-0 items-center gap-2.5 focus-visible:outline-none"
        >
          <img
            src={`${basePath}${site.images.smallAvatar}`}
            alt=""
            width="32"
            height="32"
            class="size-8 shrink-0 rounded-full object-cover ring-1 ring-line-strong"
          />
          <div>
            <SiteName class="block text-name leading-5 text-heading">
              {site.name}
            </SiteName>
            <p class="mt-0.5 text-meta leading-4 text-subtle">{site.tagline}</p>
          </div>
        </a>
        <nav
          aria-label="站点导航"
          class="-mr-2.5 flex shrink-0 items-center gap-1 text-sm text-muted"
        >
          <a
            href={site.githubUrl}
            target="_blank"
            rel="noreferrer"
            class={navLinkClass}
          >
            GitHub
          </a>
          <a href={rssPath} aria-label="RSS 订阅" class={navLinkClass}>
            RSS
          </a>
        </nav>
      </div>
    </header>
    <main class="mx-auto flex w-full max-w-site flex-1 flex-col px-5 pt-14 pb-16 sm:pt-20 sm:pb-20">
      <slot />
    </main>
    <footer class="mx-auto w-full max-w-site px-5 pb-8 text-sm text-muted">
      <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
        <p>
          © {year} {site.name}
        </p>
        {!isHome && type !== 'article' && <a href={basePath}>返回首页</a>}
      </div>
    </footer>
    {type === 'article' && <ReadingProgress />}
  </body>
</html>
