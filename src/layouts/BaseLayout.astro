---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}
const { title = '无畏小生', description = '无畏小生的个人博客。' } = Astro.props;
const base = import.meta.env.BASE_URL;
const path = Astro.url.pathname;
const year = new Date().getFullYear();

const navItems = [
  { href: base, label: '首页' },
  { href: `${base}blog/`, label: '博客' },
  { href: `${base}works/`, label: '作品' },
];
const isActive = (href: string) =>
  href === base ? path === base : path.startsWith(href);
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/lxgw-wenkai-webfont@1.7.0/style.css"
    />
    <title>{title}</title>
  </head>
  <body>
    <header class="border-b border-stone-200">
      <div class="mx-auto flex h-16 max-w-3xl items-center justify-between px-6">
        <a href={base} class="flex items-center gap-3">
          <img
            src={`${base}avatar.jpg`}
            alt="无畏小生的头像"
            class="h-8 w-8 rounded-full object-cover object-[50%_30%] ring-1 ring-stone-300"
          />
          <span class="text-xl font-bold text-stone-900">无畏小生</span>
        </a>
        <nav class="flex items-center gap-6">
          {
            navItems.map((item) => (
              <a
                href={item.href}
                class:list={[
                  'transition-colors hover:text-stone-900',
                  isActive(item.href) ? 'font-bold text-stone-900' : 'text-stone-500',
                ]}
              >
                {item.label}
              </a>
            ))
          }
        </nav>
      </div>
    </header>
    <main class="mx-auto flex min-h-[60vh] max-w-3xl flex-col px-6 py-16">
      <slot />
    </main>
    <footer class="border-t border-stone-200">
      <div class="mx-auto max-w-3xl px-6 py-8 text-center text-sm text-stone-400">
        © {year} 无畏小生
      </div>
    </footer>
  </body>
</html>
