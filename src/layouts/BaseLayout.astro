---
import '../styles/global.css';
import ReadingProgress from '../components/ReadingProgress.astro';
import { basePath } from '../lib/paths';
import { site } from '../site.config';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  noindex?: boolean;
}
const {
  title = site.name,
  description = site.description,
  type = 'website',
  publishedTime,
  noindex = false,
} = Astro.props;
const isHome = Astro.url.pathname === basePath;
const year = new Date().getFullYear();
const ogImage = new URL(`${basePath}${site.images.avatar}`, site.url).href;
const canonicalUrl = new URL(Astro.url.pathname, site.url).href;
const articlePublishedTime = publishedTime?.toISOString();
---

<!doctype html>
<html lang={site.language}>
  <head>
    <meta charset="UTF-8" />
    <link
      rel="icon"
      type="image/png"
      sizes="48x48"
      href={`${basePath}${site.images.favicon}`}
    />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href={`${basePath}${site.images.touchIcon}`}
    />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={site.language.replace('-', '_')} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={`${site.name}的头像`} />
    {articlePublishedTime && (
      <meta property="article:published_time" content={articlePublishedTime} />
    )}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <title>{title}</title>
  </head>
  <body class="flex min-h-svh flex-col">
    <main class="mx-auto flex w-full max-w-site flex-1 flex-col px-5 pt-14 pb-16 sm:pt-20 sm:pb-20">
      <div class="mb-1 h-11 shrink-0" aria-hidden="true"></div>
      {!isHome && (
        <a
          href={basePath}
          class="mb-1 inline-flex min-h-11 items-start gap-2 self-start text-sm text-muted hover:text-heading focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
        >
          <span aria-hidden="true">←</span>
          返回首页
        </a>
      )}
      <slot />
    </main>
    <footer class="mx-auto w-full max-w-site px-5 pb-8 text-meta text-muted">
      <div class="mb-4 h-px w-6 bg-line-strong" aria-hidden="true"></div>
      <p>
        © {year} {site.name}
      </p>
    </footer>
    {type === 'article' && <ReadingProgress />}
  </body>
</html>
