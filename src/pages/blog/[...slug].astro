---
import { render } from 'astro:content';
import ImageLightbox from '../../components/ImageLightbox.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { postPath } from '../../lib/paths';
import { formatPostDate, getPublishedPosts } from '../../lib/posts';
import type { Post } from '../../lib/posts';
import { site } from '../../site.config';

interface Props {
  post: Post;
  previousPost?: Post;
  nextPost?: Post;
}

export async function getStaticPaths() {
  const posts = await getPublishedPosts();

  return posts.map((post, index) => ({
    params: { slug: post.id },
    props: {
      post,
      previousPost: posts[index - 1],
      nextPost: posts[index + 1],
    },
  }));
}

const { post, previousPost, nextPost } = Astro.props;
const { Content, headings } = await render(post);
const toc = headings.filter((heading) => heading.depth === 2);
const description =
  post.data.description ?? `${post.data.title}，${site.name}的个人博客文章。`;
const date = formatPostDate(post.data.date);
const adjacentPosts = [
  { label: '上一篇', post: previousPost },
  { label: '下一篇', post: nextPost },
];

const articleText = (post.body ?? '')
  .replace(/^import[^\n]*$/gm, '')
  .replace(/<[^>]*>/g, '')
  .replace(/!\[.*?\]\(.*?\)/g, '')
  .replace(/[#>*`\-]/g, '')
  .replace(/\s/g, '');
const wordCount = articleText.length;
const readTime = Math.max(1, Math.round(wordCount / site.charactersPerMinute));
---

<BaseLayout
  title={`${post.data.title} - ${site.name}`}
  description={description}
  type="article"
  publishedTime={post.data.date}
>
  <article class="relative mx-auto w-full max-w-2xl">
    <header class="enter" style="--enter-stage: 0">
      <p class="text-sm text-muted">{date}</p>
      <h1
        id="article-title"
        tabindex="-1"
        class="mt-3 scroll-mt-20 text-[1.625rem] leading-tight text-heading sm:text-[1.75rem]"
      >
        {post.data.title}
      </h1>
      <div class="mt-3 flex items-baseline justify-between gap-4 text-sm text-muted">
        {post.data.tags[0] && <p>#{post.data.tags[0]}</p>}
        <p class="shrink-0">
          共 {wordCount} 字 · 约 {readTime} 分钟
        </p>
      </div>
      <div class="mt-8 border-t border-dashed border-line-strong"></div>
    </header>
    {toc.length > 0 && (
      <aside class="absolute top-0 left-full ml-10 hidden h-full w-52 xl:block">
        <nav
          class="enter sticky top-28 max-h-[calc(100vh-12rem)] overflow-y-auto"
          style="--enter-stage: 1"
          aria-label="文章目录"
        >
          <p class="text-sm text-heading">目录</p>
          <ul class="mt-3 space-y-2 border-l border-line text-sm">
            {toc.map((heading) => (
              <li>
                <a
                  href={`#${heading.slug}`}
                  data-toc-link={heading.slug}
                  class="-ml-px block border-l-2 border-transparent py-0.5 pl-4 text-muted"
                >
                  {heading.text}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </aside>
    )}
    <div
      class="article-content slide-enter-content prose mt-10 max-w-none"
      style="--enter-base: 1"
    >
      <Content />
    </div>
    <footer class="enter mt-16" style="--enter-stage: 3">
      <nav
        class="flex items-start justify-between gap-6 border-t border-dashed border-line-strong pt-8 text-summary"
        aria-label="上一篇 / 下一篇"
      >
        {adjacentPosts.map(({ label, post: neighbor }) => (
          <div class="min-w-0 flex-1 last:text-right">
            {neighbor && (
              <>
                <p class="text-meta text-subtle">{label}</p>
                <a
                  href={postPath(neighbor.id)}
                  class="mt-1 inline-block [overflow-wrap:anywhere] text-muted"
                >
                  {neighbor.data.title}
                </a>
              </>
            )}
          </div>
        ))}
      </nav>
    </footer>
  </article>

  <ImageLightbox />

  <script>
    const tocLinks =
      document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]');
    const articleHeadings = document.querySelectorAll('.article-content h2');

    function updateActiveHeading() {
      let currentId = articleHeadings[0].id;

      for (const heading of articleHeadings) {
        if (heading.getBoundingClientRect().top <= 96) currentId = heading.id;
      }

      for (const link of tocLinks) {
        link.classList.toggle('toc-active', link.dataset.tocLink === currentId);
      }
    }

    if (tocLinks.length > 0 && articleHeadings.length > 0) {
      updateActiveHeading();
      window.addEventListener('scroll', updateActiveHeading, { passive: true });
    }
  </script>
</BaseLayout>
