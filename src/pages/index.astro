---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import PostList from '../components/PostList.astro';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const recentPosts = posts.slice(0, 4);

// 全页入场编号单调递增，形成从上到下的波浪
let stage = 0;
const take = (n = 1) => {
  const s = stage;
  stage += n;
  return s;
};
---

<BaseLayout>
  <!-- 介绍 -->
  <section
    class="slide-enter-content flex flex-col gap-4 sm:flex-row sm:gap-12"
    style={`--enter-base: ${take(2)}`}
  >
    <SectionHeading title="介绍" sub="about" />
    <div class="min-w-0 flex-1 space-y-4 text-base leading-loose text-stone-800 dark:text-stone-200">
      <p>偶尔写写代码，也在这里记些近况和想法。</p>
      <p class="text-stone-500 dark:text-stone-400">
        年少时的一些<span
          class="underline decoration-accent decoration-wavy decoration-[1.5px] underline-offset-[6px]"
        >执念</span>，仍想慢慢实现。
      </p>
    </div>
  </section>

  <!-- 博客 -->
  <section class="mt-16 flex flex-col gap-5 border-t border-stone-200 pt-16 sm:flex-row sm:gap-12 dark:border-stone-800">
    <div class="enter shrink-0" style={`--enter-stage: ${take()}`}>
      <SectionHeading title="博客" sub="blog" />
    </div>
    <PostList posts={recentPosts} baseStage={take(recentPosts.length)}>
      <div
        class="enter mt-4 flex"
        style={`--enter-stage: ${take()}`}
      >
        <a
          href={`${base}blog/`}
          class="inline-flex items-center gap-1.5 rounded-sm py-1 whitespace-nowrap text-sm text-stone-500 transition-colors duration-200 hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent dark:text-stone-400 dark:hover:text-accent"
        >
          更多文章
          <svg
            class="h-3 w-3"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M5 12h14m-6-6 6 6-6 6" />
          </svg>
        </a>
      </div>
    </PostList>
  </section>

  <!-- 作品 -->
  <section
    class="slide-enter-content mt-16 flex flex-col gap-5 border-t border-stone-200 pt-16 sm:flex-row sm:gap-12 dark:border-stone-800"
    style={`--enter-base: ${take(2)}`}
  >
    <SectionHeading title="作品" sub="work" />
    <p class="min-w-0 flex-1 text-base leading-relaxed text-stone-600 dark:text-stone-300">
      还在慢慢积累，等有满意的作品再放在这里。
    </p>
  </section>
</BaseLayout>
