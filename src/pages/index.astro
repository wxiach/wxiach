---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import { getPublishedPosts } from '../lib/posts';
import { basePath } from '../lib/paths';
import { site } from '../site.config';

const posts = await getPublishedPosts();
const postsHeadingStage = site.introduction.length + 3;
const postsStage = postsHeadingStage + 1;
const projectsStage = postsStage + posts.length;
---

<BaseLayout>
  <div class="home-content">
    <aside class="profile" aria-label="关于作者">
      <div class="profile-identity enter" style="--enter-stage: 0">
        <span class="profile-avatar-wrap">
          <img
            src={`${basePath}${site.images.avatar}`}
            alt=""
            width="80"
            height="80"
            class="profile-avatar"
          />
        </span>
        <div>
          <h1>{site.name}</h1>
          <p class="profile-tagline">{site.tagline}</p>
        </div>
      </div>
      <a
        href={site.githubUrl}
        target="_blank"
        rel="noreferrer"
        class="profile-github enter"
        style="--enter-stage: 1"
        aria-label="GitHub"
      >
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12Z" />
        </svg>
      </a>
    </aside>

    <section class="introduction" aria-labelledby="introduction-heading">
      <h2
        id="introduction-heading"
        class="section-label enter"
        style="--enter-stage: 2"
      >
        <span class="section-number" aria-hidden="true">
          01 /
        </span>
        <span>介绍</span>
      </h2>
      <div class="space-y-2 text-base leading-7">
        {site.introduction.map((paragraph, index) => (
          <p class="enter" style={`--enter-stage: ${index + 3}`}>
            {paragraph}
          </p>
        ))}
      </div>
    </section>

    <section class="posts-section" aria-labelledby="posts-heading">
      <h2
        id="posts-heading"
        class="section-label enter"
        style={`--enter-stage: ${postsHeadingStage}`}
      >
        <span class="section-number" aria-hidden="true">
          02 /
        </span>
        <span>博客</span>
      </h2>
      <PostList posts={posts} baseStage={postsStage} />
    </section>

    <section class="projects-section" aria-labelledby="projects-heading">
      <h2
        id="projects-heading"
        class="section-label enter"
        style={`--enter-stage: ${projectsStage}`}
      >
        <span class="section-number" aria-hidden="true">
          03 /
        </span>
        <span>作品</span>
      </h2>
      <div class="enter" style={`--enter-stage: ${projectsStage + 1}`}>
        <p class="text-summary text-muted">{site.projectsPlaceholder}</p>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .home-content {
    --enter-max-delay: 720ms;
    display: grid;
    grid-template-areas:
      'profile'
      'introduction'
      'posts'
      'projects';
    align-items: start;
    gap: 2.5rem;
  }

  .profile {
    grid-area: profile;
    min-width: 0;
  }

  .introduction {
    grid-area: introduction;
  }

  .posts-section {
    grid-area: posts;
    min-width: 0;
  }

  .projects-section {
    grid-area: projects;
    min-width: 0;
  }

  .profile-avatar {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    flex-shrink: 0;
    border-radius: 50%;
    object-fit: cover;
    transition: transform 1.2s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .profile-avatar-wrap {
    position: relative;
    display: inline-flex;
    width: 4rem;
    height: 4rem;
    flex-shrink: 0;
    border-radius: 50%;
    isolation: isolate;
  }

  .profile-avatar-wrap::before {
    position: absolute;
    inset: -0.1875rem;
    z-index: 0;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      color-mix(in oklab, var(--color-accent) 90%, transparent) 40%,
      transparent 70%
    );
    content: '';
    filter: blur(0.25rem);
    animation: avatar-glow 1.8s ease-in-out infinite;
  }

  .profile-avatar-wrap::after {
    position: absolute;
    inset: -1px;
    z-index: 2;
    border: 1px solid var(--color-accent);
    border-radius: 50%;
    content: '';
    animation: avatar-ring 1.8s ease-in-out infinite;
  }

  .profile-avatar-wrap:hover .profile-avatar {
    transform: rotate(360deg);
    transition-duration: 2s;
  }

  .profile-identity {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .profile h1 {
    color: var(--color-heading);
    font-size: 1.125rem;
    font-weight: 500;
    line-height: 1.5;
  }

  .profile-tagline {
    margin-top: 0.375rem;
    color: var(--color-subtle);
    font-size: var(--text-meta);
    line-height: 1.5;
  }

  .profile-github {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    margin-top: 1.5rem;
    color: var(--color-line-strong);
    transition: color 0.15s ease;
  }

  .profile-github svg {
    width: 1.125rem;
    height: 1.125rem;
  }

  .profile-github:hover {
    color: var(--color-accent);
  }

  .profile-github:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
  }

  .section-label {
    display: flex;
    align-items: baseline;
    gap: 0.625rem;
    margin-bottom: 1rem;
    color: var(--color-ink);
    font-size: 0.875rem;
    font-weight: 400;
    line-height: 1.5;
    letter-spacing: normal;
  }

  .section-number {
    color: var(--color-subtle);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
  }

  @media (min-width: 80rem) and (min-height: 36rem) {
    .home-content {
      grid-template-areas:
        'introduction'
        'posts'
        'projects';
    }

    .profile {
      position: fixed;
      top: 8rem;
      right: clamp(2rem, 5vw, 6rem);
      width: 10rem;
    }

    .profile-avatar-wrap {
      width: 5rem;
      height: 5rem;
    }

    .profile-identity {
      flex-direction: column;
      align-items: flex-start;
      gap: 2rem;
    }

    .profile-tagline {
      margin-top: 0.75rem;
    }

    .profile-github {
      margin-left: -0.5625rem;
    }
  }

  @keyframes avatar-glow {
    0%,
    100% {
      opacity: 0;
      transform: scale(0.9);
    }

    50% {
      opacity: 1;
      transform: scale(1.06);
    }
  }

  @keyframes avatar-ring {
    0%,
    100% {
      opacity: 0;
    }

    50% {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .profile-avatar-wrap::before,
    .profile-avatar-wrap::after {
      animation: none;
    }

    .profile-avatar {
      transition: none;
    }

    .profile-avatar-wrap:hover .profile-avatar {
      transform: none;
    }
  }
</style>
