---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ProjectCards from '../components/ProjectCards.astro';
import { getPublishedPosts } from '../lib/posts';
import { site } from '../site.config';

const posts = await getPublishedPosts();
const postsHeadingStage = site.introduction.length;
const postsStage = postsHeadingStage + 1;
const projectsStage = postsStage + posts.length;
---

<BaseLayout>
  <div class="home-content space-y-12 sm:space-y-14">
    <div class="space-y-2 text-base leading-7">
      {site.introduction.map((paragraph, index) => (
        <p class="enter" style={`--enter-stage: ${index}`}>
          {paragraph}
        </p>
      ))}
    </div>

    <section aria-labelledby="posts-heading">
      <h2
        id="posts-heading"
        class="section-label enter"
        style={`--enter-stage: ${postsHeadingStage}`}
      >
        博客
      </h2>
      <PostList posts={posts} baseStage={postsStage} />
    </section>

    <section aria-labelledby="projects-heading">
      <h2
        id="projects-heading"
        class="section-label enter"
        style={`--enter-stage: ${projectsStage}`}
      >
        作品
      </h2>
      <div class="enter" style={`--enter-stage: ${projectsStage + 1}`}>
        {site.projects.length > 0 ? (
          <ProjectCards>
            {site.projects.map((project) => (
              <ProjectCard {...project} />
            ))}
          </ProjectCards>
        ) : (
          <p class="text-summary text-muted">{site.projectsPlaceholder}</p>
        )}
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .home-content {
    --enter-max-delay: 720ms;
  }

  .section-label {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    margin-bottom: 1rem;
    color: var(--color-muted);
    font-size: 0.875rem;
    line-height: 1.25rem;
    letter-spacing: 0.08em;
  }

  .section-label::after {
    content: '';
    width: 1.25rem;
    height: 1px;
    background-color: var(--color-line-strong);
  }
</style>
