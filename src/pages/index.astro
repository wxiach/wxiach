---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import PostList from '../components/PostList.astro';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const recentPosts = posts.slice(0, 4);

// 全页入场编号单调递增，形成从上到下的波浪
let stage = 0;
const take = (n = 1) => {
  const s = stage;
  stage += n;
  return s;
};
---

<BaseLayout>
  <!-- 介绍 -->
  <section
    class="slide-enter-content flex flex-col gap-4 sm:flex-row sm:gap-12"
    style={`--enter-base: ${take(2)}`}
  >
    <SectionHeading title="介绍" sub="about" />
    <div class="min-w-0 flex-1 space-y-5 text-base leading-loose text-stone-800 dark:text-stone-200">
      <p>
        <span class="inline-block origin-[70%_75%] hover:animate-wave">👋</span>
        嗨，欢迎来到这里呀！
      </p>
      <p>
        我曾经是个程序员，现在似乎也是，希望未来不是。
        <span class="italic text-stone-500 dark:text-stone-400">
          （最近的状态不算好，但我确定只是暂时的。）
        </span>
      </p>
      <p>
        我正在完成年少时的一些
        <span class="font-bold underline decoration-accent decoration-wavy decoration-[1.5px] underline-offset-[6px]">
          执念
        </span>
        。
      </p>
    </div>
  </section>

  <!-- 博客 -->
  <section class="mt-16 flex flex-col gap-5 border-t border-stone-200 pt-16 sm:flex-row sm:gap-12 dark:border-stone-800">
    <div class="enter shrink-0" style={`--enter-stage: ${take()}`}>
      <SectionHeading title="博客" sub="blog" />
    </div>
    <PostList posts={recentPosts} baseStage={take(recentPosts.length)}>
      <div
        class="enter mt-6 flex justify-end"
        style={`--enter-stage: ${take()}`}
      >
        <a
          href={`${base}blog/`}
          class="group inline-flex items-center whitespace-nowrap text-sm text-stone-500 underline decoration-stone-300 underline-offset-4 transition-colors hover:decoration-accent hover:text-accent dark:text-stone-400 dark:decoration-stone-700 dark:hover:text-accent dark:hover:decoration-accent"
        >
          更多文章
          <span class="ml-1 inline-block transition-transform group-hover:translate-x-0.5">
            →
          </span>
        </a>
      </div>
    </PostList>
  </section>

  <!-- 作品 -->
  <section
    class="slide-enter-content mt-16 flex flex-col gap-5 border-t border-stone-200 pt-16 sm:flex-row sm:gap-12 dark:border-stone-800"
    style={`--enter-base: ${take(2)}`}
  >
    <SectionHeading title="作品" sub="work" />
    <p class="min-w-0 flex-1 text-base leading-relaxed text-stone-600 dark:text-stone-300">
      还在慢慢积累，等有满意的作品再放在这里。
    </p>
  </section>
</BaseLayout>
