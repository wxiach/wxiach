---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '@site-config';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<BaseLayout title={`404 - ${site.name}`}>
  <section class="slide-enter-content flex flex-1 flex-col items-center justify-center text-center">
    <p class="text-7xl font-bold tracking-widest text-line-strong sm:text-8xl">
      404
    </p>
    <h1 class="mt-6 text-xl font-bold text-heading">
      页面不存在
    </h1>
    <p class="mt-3 text-muted">
      你要找的页面走丢了，或者从未存在过。
    </p>
    <a
      href={base}
      class="group mt-8 inline-flex items-center text-sm text-muted transition-colors hover:text-heading"
    >
      <span class="mr-1 inline-block transition-transform group-hover:-translate-x-0.5">
        ←
      </span>
      返回首页
    </a>
  </section>
</BaseLayout>
