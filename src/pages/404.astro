---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;
---

<BaseLayout title="404 - 无畏小生">
  <section class="slide-enter-content flex flex-1 flex-col items-center justify-center text-center">
    <p class="text-7xl font-bold tracking-widest text-stone-300 sm:text-8xl dark:text-stone-700">404</p>
    <h1 class="mt-6 text-2xl font-bold text-stone-900 dark:text-stone-100">页面不存在</h1>
    <p class="mt-3 text-stone-500 dark:text-stone-400">
      你要找的页面走丢了，或者从未存在过。
    </p>
    <a
      href={base}
      class="group mt-8 inline-flex items-center text-sm text-stone-500 transition-colors hover:text-stone-900 dark:text-stone-400 dark:hover:text-stone-100"
    >
      <span class="mr-1 inline-block transition-transform group-hover:-translate-x-0.5">←</span>
      返回首页
    </a>
  </section>
</BaseLayout>
